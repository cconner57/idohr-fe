{
  "name": "idohr",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": "^9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "npm run build-only && wrangler dev",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:check": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "check": "run-p type-check lint:check lint:style test:check test:e2e",
    "format": "prettier --write src/",
    "deploy": "npm run build-only && wrangler pages deploy dist --project-name=idohr-fe --branch=main"
  },
  "dependencies": {
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.8.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.129.0"
  }
}
